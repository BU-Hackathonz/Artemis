{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Local main window launch configuration, push-to-talk and bounded desktop status/reveal commands",
  "local": true,
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-get-core-config",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered",
    "allow-update-companion-status",
    "allow-enter-compact",
    "allow-reveal-approval"
  ]
}
