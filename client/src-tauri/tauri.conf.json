{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Artemis",
  "version": "0.1.0",
  "identifier": "org.hackathonz.artemis",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Artemis",
        "width": 1100,
        "height": 800,
        "minWidth": 400,
        "minHeight": 500
      },
      {
        "label": "agent",
        "url": "index.html#agent",
        "title": "Artemis island",
        "width": 208,
        "height": 56,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      },
      {
        "label": "flow",
        "url": "index.html#flow",
        "title": "Artemis flow",
        "width": 800,
        "height": 600,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:*; img-src 'self' data:; object-src 'none'; base-uri 'self'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/256x256.png",
      "icons/icon.ico"
    ]
  }
}
